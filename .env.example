NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string. Paste the same value into the Meta webhook form.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-string

# App secret from the Meta app dashboard. Used to verify webhook signatures.
META_APP_SECRET=your-meta-app-secret

# Protects /api/cron/dispatch. Vercel Cron sends this as a Bearer token.
CRON_SECRET=replace-with-a-long-random-string

# Optional. Defaults to v23.0. Change if Meta rejects the version.
WHATSAPP_GRAPH_VERSION=v23.0

NEXT_PUBLIC_APP_URL=http://localhost:3000
